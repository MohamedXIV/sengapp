# Sengapp Phase 0 — development example; never commit actual secrets.
# Copy to .env.local after creating a Clerk app and Sengapp Convex deployment.

# Next.js / Convex frontend
CONVEX_DEPLOYMENT=dev:replace_with_deployment_name
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-deployment.convex.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (from Clerk Dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Set ONLY in the Sengapp Convex deployment's server environment:
# CLERK_JWT_ISSUER_DOMAIN=https://replace-with-your-clerk-frontend-api.clerk.accounts.dev
# SENGAPP_OPERATOR_EMAILS=your-verified-operator@example.com
# Do not put either value in NEXT_PUBLIC_* variables.
