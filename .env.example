# Sengapp Phase 0 — Environment Configuration Template
# Copy this file to .env.local for local Next.js development.
# Never commit real secrets or production tokens to version control.

# 1. Convex Backend Endpoints
# Generated automatically when running `npx convex dev`
CONVEX_DEPLOYMENT=dev:replace_with_deployment_name
NEXT_PUBLIC_CONVEX_URL=replace_with_your_convex_cloud_origin
NEXT_PUBLIC_CONVEX_SITE_URL=replace_with_your_convex_site_origin

# 2. Application Canonical Origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set in your Convex deployment with `npx convex env set SITE_URL http://localhost:3000`
SITE_URL=http://localhost:3000

# 3. Better Auth Configuration (also set inside Convex via `npx convex env set`)
# Generate secret via: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_32_byte_base64_secret
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# 4. Initial Operator Bootstrap Identifier
# Comma-separated allowlist, checked ONLY against verified Better Auth provider identities.
SENGAPP_OPERATOR_EMAILS=replace_with_verified_operator_email
